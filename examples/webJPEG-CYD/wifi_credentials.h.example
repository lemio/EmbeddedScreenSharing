// Copy this file to wifi_credentials.h (gitignored - see .gitignore) and fill in real
// values to build/flash locally with working WiFi without editing webJPEG-CYD.cpp's
// tracked "|*S*|"/"|*P*|" placeholders. CI never has this file, so GitHub Actions
// builds always ship with the placeholders intact for the browser flasher to patch.
#define WIFI_SSID "YourNetworkName"
#define WIFI_PASSWORD "YourPassword"
