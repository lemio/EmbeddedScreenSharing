  "firmwares": {
    "webH264": {
      "name": "WebH264 Stream Display",
      "description": "Streams a browser tab or window to the AMOLED display over WiFi as H.264, encoded in-browser with WebCodecs and decoded on-device. Sharper image and much lower bandwidth than WebJPEG at the same quality, at the cost of a slower decoder (roughly 3-5fps). T4-S3 (2.41\", 600x450) only. Built 2026-08-04.",
      "files": [
        {
          "path": "firmware/webH264/bootloader.bin",
          "offset": 0
        },
        {
          "path": "firmware/webH264/partitions.bin",
          "offset": 32768
        },
        {
          "path": "firmware/webH264/boot_app0.bin",
          "offset": 57344
        },
        {
          "path": "firmware/webH264/firmware.bin",
          "offset": 65536
        }
      ],
      "hardware": "T4-S3",
      "variables": [
        {
          "firmware_name": "|*S*|",
          "readable_name": "WiFi Name (SSID)",
          "default_value": "",
          "max_length": 100
        },
        {
          "firmware_name": "|*P*|",
          "readable_name": "WiFi Password",
          "default_value": "",
          "max_length": 100
        },
        {
          "firmware_name": "esp-screen",
          "readable_name": "mDNS Hostname",
          "default_value": "esp-screen",
          "postfix": ".local",
          "max_length": 100
        }
      ],
      "sourceUrl": "https://github.com/lemio/EmbeddedScreenSharing/tree/main/examples/webH264"
    },
