{
  "site": {
    "title": "Embedded Screen Sharing Flasher",
    "subtitle": "Flash a browser-to-display video streamer straight from your browser - no PlatformIO needed"
  },
  "firmwares": {
    "webH264": {
      "name": "WebH264 Stream Display",
      "description": "Streams a browser tab or window to the display over WiFi as video, using the same H.264 format as most streaming apps. Sharper image and lower WiFi usage than WebJPEG. Works on any AMOLED board (auto-detected). Built 2026-08-06.",
      "files": [
        {
          "path": "firmware/webH264/bootloader.bin",
          "offset": 0
        },
        {
          "path": "firmware/webH264/partitions.bin",
          "offset": 32768
        },
        {
          "path": "firmware/webH264/boot_app0.bin",
          "offset": 57344
        },
        {
          "path": "firmware/webH264/firmware.bin",
          "offset": 65536
        }
      ],
      "mcu": "esp32s3",
      "hardware": [
        {
          "name": "LilyGo T-Display-AMOLED-Lite",
          "url": "https://www.lilygo.cc/products/t-display-amoled-lite"
        },
        {
          "name": "LilyGo T-Display S3 AMOLED",
          "url": "https://lilygo.cc/products/t-display-s3-amoled"
        },
        {
          "name": "LilyGo T4-S3",
          "url": "https://lilygo.cc/products/t4-s3"
        }
      ],
      "variables": [
        {
          "firmware_name": "|*S*|",
          "readable_name": "WiFi Name (SSID)",
          "default_value": "",
          "max_length": 100
        },
        {
          "firmware_name": "|*P*|",
          "readable_name": "WiFi Password",
          "default_value": "",
          "max_length": 100
        },
        {
          "firmware_name": "esp-screen",
          "readable_name": "mDNS Hostname",
          "default_value": "esp-screen",
          "postfix": ".local",
          "max_length": 100
        }
      ],
      "expectedBehavior": [
        "Device connects to WiFi and shows its IP address and mDNS hostname on screen",
        "Open the streaming page linked above and share a browser tab or window",
        "Live serial output below shows connection status and per-frame timing in real time"
      ],
      "sourceUrl": "https://github.com/lemio/EmbeddedScreenSharing/tree/main/examples/webH264",
      "recommended": true
    },
